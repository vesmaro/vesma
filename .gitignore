.history/

# Code review reports (local)
.cr/

# gRPC codegen output — regenerated from federation/proto/*.proto via
# `python -m grpc_tools.protoc` (see federation/proto/buf.gen.yaml for the
# buf equivalent). Never commit; the .proto files are the source of truth.
federation/gen/

# E3 run artifacts (benchmarks/experiments/e3_lanes/runs/) — run
# manifests/outcomes stay on disk after --record; the E3 report wave
# commits them deliberately when citing them. Keeps the worktree clean
# between record and archival so run-manifest git_dirty stays stable.
benchmarks/experiments/e3_lanes/runs/

# E3 D-leg run artifacts (benchmarks/experiments/e3_d/runs/) — run
# artifacts stay on disk and are committed deliberately by the report
# wave when citing them (same discipline as e3_lanes).
benchmarks/experiments/e3_d/runs/

# F1 task-scope run artifacts (benchmarks/experiments/f1_task_scope/
# runs/) — same discipline: --record artifacts stay on disk, the F1
# report wave commits them deliberately when citing.
benchmarks/experiments/f1_task_scope/runs/
.venv
