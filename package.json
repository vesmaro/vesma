{
  "name": "pi-mnemos",
  "version": "4.3.0",
  "description": "Mnemos memory & knowledge server — Pi extension. Spawns `mnemos mcp-server` over stdio and exposes every mnemos_* tool as a native Pi tool, plus the mnemos skill pack.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Korrnals",
  "homepage": "https://github.com/vesmaro/vesmaro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vesmaro/vesmaro.git"
  },
  "bugs": {
    "url": "https://github.com/vesmaro/vesmaro/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "memory",
    "mnemos",
    "ai",
    "coding-agent",
    "extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./integrations/extensions/vesma-mcp.ts"
    ],
    "skills": [
      "./integrations/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "files": [
    "integrations/extensions/",
    "integrations/skills/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pipeline": {
    "npmPublishNames": [
      "pi-mnemos",
      "mnemos-pi",
      "@korrlabs/mnemospi",
      "@korrlabs/mnemos-pi"
    ]
  }
}
