[Unit]
Description=Vesma — auto-cron federation bridge (#104) sync-peers.sh
Documentation=file:///usr/share/doc/vesma/admin/ssh-sync-hardening.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vesma-sync
Group=vesma-sync
EnvironmentFile=/etc/vesma/sync.env
ExecStart=/usr/local/sbin/sync-peers.sh
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/vesma-sync /var/log/vesma-sync.log
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target