# /etc/vesma/sync.env — environment for vesma-sync.service (#104)
#
# Loaded by the systemd unit via EnvironmentFile=. Every var here is read by
# scripts/sync-peers.sh on A (the SOURCE host). The passphrase VALUE lives in a
# SEPARATE env var named by VESMA_SYNC_PASSPHRASE_ENV — never inline here.
#
# All values below are RFC-reserved dummies (RFC 5737 IPs, example.invalid).
# Replace every one before `systemctl enable --now vesma-sync.timer`.
#
# See docs/en/admin/ssh-sync-hardening.md for the full hardening checklist.

# ── REQUIRED (script refuses to run without these) ───────────────────────────

# Peer (TARGET) host B — the vesma instance that imports the payload.
VESMA_SYNC_PEER_HOST=192.0.2.10

# Ed25519 private key on A for the rsync PUSH step (step 2/3 of sync-peers.sh).
# chmod 600, owner root. Generate per ssh-sync-hardening.md §3.
VESMA_SYNC_PEER_SSH_KEY=/etc/vesma/sync-push-key

# Ed25519 private key on A for the ssh IMPORT-TRIGGER step (step 3/3).
# Separate key from the push key — each is pinned to its own command="" in
# authorized_keys on B (ssh-sync-hardening.md §2). chmod 600, owner root.
VESMA_SYNC_PEER_IMPORT_SSH_KEY=/etc/vesma/sync-trigger-key

# Local dir on A where `vesma sync export` writes the payload file.
VESMA_SYNC_LOCAL_EXPORT_DIR=/var/lib/vesma-sync/export

# Dir on B where rsync delivers the payload. Must match the INCOMING_DIR
# enforced by contrib/systemd/rsync-wrapper.sh on B.
VESMA_SYNC_REMOTE_IMPORT_DIR=/var/lib/vesma-sync/incoming

# Comma-separated project slugs to sync (must be in shared_projects on A).
VESMA_SYNC_SHARED_PROJECTS=project-alpha

# Encrypt the payload with AES-256-GCM before transfer? "true" | "false".
VESMA_SYNC_ENCRYPT=true

# NAME of the env var holding the passphrase on A. The passphrase VALUE is
# provisioned in the service environment (systemd LoadCredential or drop-in),
# NEVER inline in this file. sync-peers.sh reads it via ${!NAME}.
VESMA_SYNC_PASSPHRASE_ENV=VESMA_EXPORT_PASSPHRASE

# ── OPTIONAL (defaults shown) ───────────────────────────────────────────────

# SSH user on B (default: vesma-sync). Must match the dedicated user created
# per ssh-sync-hardening.md §1.
# VESMA_SYNC_PEER_USER=vesma-sync

# Dry-run — "1" logs the commands to stderr and exits 0 before any real
# execution (no export, no rsync, no ssh). Use for first-time validation.
# VESMA_SYNC_DRY_RUN=0

# Path to A's vesma config.yaml (default: vesma auto-discovery).
# VESMA_SYNC_SOURCE_CONFIG=

# Basename of the payload file on B (default: vesma-sync-<UTC-timestamp>.json).
# VESMA_SYNC_REMOTE_FILE=

# Path to the vesma CLI on A (default: auto-discover via PATH or .venv).
# VESMA_SYNC_VESMA_BIN=

# ── PASSPHRASE VALUE (separate from the NAME above) ──────────────────────────
# Provision this via `systemctl edit vesma-sync.service` (a drop-in) or via
# systemd LoadCredential — NOT in this file, which may be world-readable.
# The NAME in VESMA_SYNC_PASSPHRASE_ENV must point at this var.
#
# Example drop-in (/etc/systemd/system/vesma-sync.service.d/passphrase.conf):
#   [Service]
#   Environment="VESMA_EXPORT_PASSPHRASE=<your-secret-here>"
#
# Or LoadCredential (preferred — file-based, not in `systemctl show`):
#   [Service]
#   LoadCredential=vesma-export-passphrase:/etc/vesma/passphrase
#   Environment="VESMA_EXPORT_PASSPHRASE_FILE=%d/vesma-export-passphrase"
# (then sync-peers.sh reads $VESMA_EXPORT_PASSPHRASE — adapt if you use the
#  _FILE variant; vesma sync export currently reads the env var directly.)