# @@UNIT_NAME@@ — vesma memory node server face.
# Generated by vesma-node (contrib/node-install). Placeholders are
# rendered at install time; regenerating is safe (idempotent bundle).
[Unit]
Description=@@DESCRIPTION@@
Documentation=https://github.com/vesmaro/vesma
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
@@USER_LINE@@
EnvironmentFile=-@@ENVFILE@@
@@MKDIR_LINE@@
ExecStart=@@VENV@@/bin/vesma serve --config @@CONF@@
# Wait for /health before systemd marks the unit started.
ExecStartPost=/bin/sh -c 'i=0; while [ $i -lt 30 ]; do curl -sf -m 2 http://127.0.0.1:@@PORT@@/health >/dev/null && exit 0; i=$((i+1)); sleep 2; done; exit 1'
TimeoutStartSec=150
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
@@HARDENING@@

[Install]
WantedBy=multi-user.target
