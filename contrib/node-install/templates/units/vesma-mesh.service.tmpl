# vesma-mesh.service — federation transport for the vesma node.
# Generated by vesma-node (contrib/node-install). Same unit name as
# the upstream mesh package so the two never duplicate each other.
[Unit]
Description=mnemos-mesh — federation transport for vesma node
Documentation=https://github.com/vesmaro/vesma-mesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
@@USER_LINE@@
@@MKDIR_LINE@@
ExecStart=@@MESHBIN@@ serve -config @@MESHCONF@@
# Cert rotation: the mesh reloads its mTLS material in place on SIGHUP.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
@@HARDENING@@

[Install]
WantedBy=multi-user.target
