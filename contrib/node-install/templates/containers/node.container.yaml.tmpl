# node.container.yaml — core face config for the CONTAINER install
# (rendered by `vesma-node container-install`; replace-mounts the
# image's /app/config.yaml via MNEMOS_CONFIG/VESMARO_CONFIG — a YAML
# file value beats env vars, so the bind-mounted file is the only way
# to re-bind host/port/auth).
#
# Container paths only: data/vault are bind-mounts from the HOST
# (local-first — the container carries code, never data). Operator
# editable; kept on re-runs unless --reconf.

mnemos:
  vault_path: /vault
  data_dir: /data

embedding:
  # mnema-embed-v1: bundled in the image, works offline.
  provider: nano

search:
  default_limit: 20
  # 0.5 balances FTS/vector legs (issue #300 probe) — same as the
  # shipped container config.
  hybrid_alpha: 0.5

api:
  # Loopback posture (same as the host install): the core face is NOT
  # exposed remotely; remote access rides the mesh (mTLS). Widening the
  # bind requires auth: see the Container install section of
  # contrib/node-install/README.md.
  host: "127.0.0.1"
  port: @@PORT@@
  auth_enabled: false
  totp_enabled: false
  behind_tls_proxy: false
  cors_enabled: false

mesh:
  # Master switch mirrors the host install: on only when the mTLS
  # material is present (the core fails fast on a TCP leg without
  # readable certs — MeshTCPLegError).
  enabled: @@MESH_ENABLED@@
  socket_path: /run/vesma/core.sock
  timeout_s: 5.0
  tcp:
    enabled: @@MESH_ENABLED@@
    port: 8790
    bind: "127.0.0.1"
    tls:
      cert_file: /etc/vesma/pki/core.pem
      key_file: /etc/vesma/pki/core.key
      ca_file: /etc/vesma/pki/ca.pem
