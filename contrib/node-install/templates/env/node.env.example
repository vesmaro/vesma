# node.env — secrets for the core face unit (EnvironmentFile).
# Installed mode 0600 by vesma-node. Fill what you need; every line
# is optional — the core face on loopback needs none of them by default.

# Example overrides (VESMA_ prefix maps onto config sections):
#VESMA_API__AUTH_ENABLED=false
#VESMA_LOGGING__LEVEL=INFO
