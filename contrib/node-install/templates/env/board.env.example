# board.env — secrets for the board face unit (profile: laptop).
# Installed mode 0600 by vesma-node; the key below is AUTO-GENERATED
# on first install (random 32-byte urlsafe token) to satisfy the
# non-loopback startup guard. Replace/rotate as you see fit — never
# commit this file, never paste its values into tickets or chat.

# Required: board binds 0.0.0.0 → the 4.3.0+ startup guard demands it.
VESMA_API__TOTP_MASTER_KEY=__GENERATED__

# Bearer token for board clients (vesma-eyes). Generate your own:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#VESMA_API__BEARER_TOKENS=replace-me
