# vesma-eyes platform env slot — template.
#
# Copy to the env.d slot of the target plane, make it 0600, fill REAL
# values:
#
#   user:   cp eyes.env.example ~/.vesma/env.d/eyes.env
#           chmod 600 ~/.vesma/env.d/eyes.env
#   system: sudo cp eyes.env.example /etc/vesma/env.d/eyes.env
#           sudo chmod 600 /etc/vesma/env.d/eyes.env
#           sudo chown root:vesma /etc/vesma/env.d/eyes.env   # if root-installed
#
# Fail-closed: the supervisor refuses the eyes start unless this file
# exists with EXACTLY mode 0600, owned by the supervisor user, and
# OUTSIDE the manifests directory (layout §3.5, LY-03). Values here are
# tainted as secrets downstream (never cached, never logged).
#
# Never commit a filled copy of this file.

# The vesma engine this board serves: default instance API endpoint.
MNEMOS_URL=http://127.0.0.1:8787

# Engine API token (vesma operator: `vesma auth` / api-key mint; the
# token must be allowed for the endpoints the board calls).
MNEMOS_TOKEN=change-me-engine-api-token

# Board write guard (mutations over the board API).
VESMARO_BOARD_TOKEN=change-me-board-write-token

# UI write guard (ADR 0009 A1 token split: ui-class endpoints).
VESMARO_UI_TOKEN=change-me-ui-write-token

# SSRF egress allowlist for memory-server hosts (security.py): the ONLY
# hosts the board will proxy to. Comma-separated.
VESMARO_ALLOWED_MEMORY_HOSTS=127.0.0.1,localhost
